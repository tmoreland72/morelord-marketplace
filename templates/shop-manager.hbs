<section class="ml-app ml-app-shell ml-marketplace-shop-manager ml-marketplace-shop-manager-shell {{#if isWorking}}is-working{{/if}}">
  {{#if isWorking}}
    <div class="ml-marketplace-shop-working-overlay" aria-live="polite" aria-busy="true">
      <div class="ml-marketplace-shop-working-card">
        <i class="fa-solid fa-spinner fa-spin"></i>
        <strong>{{workingMessage}}</strong>

      </div>
    </div>
  {{/if}}
  <header class="ml-hero ml-marketplace-shops-heading"><i class="fa-solid fa-store ml-hero__icon"></i><div class="ml-hero__body"><h1>{{#if isNewShop}}New Shop{{else}}Marketplace Shops{{/if}}</h1></div><div class="ml-actions"><button type="button" data-action="openDocumentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div></header>
  <aside class="ml-marketplace-shop-list-panel" data-ml-scroll-key="shop-library">
    {{#unless isNewShop}}
    <div class="ml-actions">
      <button type="button" data-action="newShop"><i class="fa-solid fa-plus"></i> New Shop</button>
      <button type="button" data-action="importShop" title="Import a portable shop definition">
        <i class="fa-solid fa-file-import"></i><span>Import Shop</span>
      </button>
    </div>

    <section class="ml-marketplace-shop-library-section">
      <div class="ml-marketplace-shop-library-heading">
        <div>
          <span class="ml-marketplace-shop-manager-eyebrow">Current World</span>
          <h3>Existing Stores</h3>
        </div>
        <span class="ml-marketplace-shop-count">{{shops.length}}</span>
      </div>

      <div class="ml-marketplace-shop-list">
        {{#each shops}}
          <button type="button" class="ml-list-button ml-marketplace-shop-list-item ml-marketplace-shop-card {{#if selected}}is-active{{/if}}" data-action="selectShop" data-shop-id="{{id}}" {{#if selected}}aria-current="true"{{/if}}>
            <img class="ml-marketplace-shop-card-image" src="{{img}}" alt="">
            <span class="ml-marketplace-shop-card-body">
              <strong class="ml-marketplace-shop-card-name">{{name}}</strong>
              <small class="ml-marketplace-shop-card-type">{{typeLabel}}</small>
              <span class="ml-marketplace-shop-card-tags">
                {{#each tags}}
                  <span class="ml-marketplace-shop-card-tag"><i class="fa-solid {{icon}}"></i>{{label}}</span>
                {{/each}}
              </span>
            </span>
            <i class="fa-solid fa-chevron-right ml-marketplace-shop-card-chevron"></i>
          </button>
        {{else}}
      <div class="ml-empty-message ml-marketplace-shop-empty">No stores have been created in this world yet.</div>
        {{/each}}
      </div>
    </section>

    {{else}}
    <section class="ml-marketplace-shop-library-section">
      <div class="ml-marketplace-shop-library-heading">
        <div>
          <span class="ml-marketplace-shop-manager-eyebrow">Quick Start</span>
          <h3>Store Templates</h3>
        </div>
      </div>

      <div class="ml-marketplace-shop-preset-grid">
        {{#each presets}}
          <button type="button" class="ml-marketplace-shop-preset-card" data-action="createShop" data-shop-type="{{key}}" title="Create {{label}}">
            <span class="ml-marketplace-shop-preset-icon"><i class="fa-solid {{icon}}"></i></span>
            <span>{{label}}</span>
          </button>
        {{/each}}
      </div>
    </section>

    <section class="ml-marketplace-shop-library-section ml-marketplace-prefab-library-section">
      <div class="ml-marketplace-shop-library-heading">
        <div>
          <span class="ml-marketplace-shop-manager-eyebrow">Shop Compendium</span>
          <h3>Prefab Stores</h3>
        </div>
        <span class="ml-marketplace-shop-count">{{prefabs.length}}</span>
      </div>

      <div class="ml-marketplace-prefab-list">
        {{#each prefabs}}
          <button
            type="button"
            class="ml-marketplace-prefab-card"
            data-action="createPrefabShop"
            data-prefab-id="{{id}}"
            title="Create {{name}} with {{matchedCount}} matched items">
            <span class="ml-marketplace-prefab-card-icon"><i class="fa-solid fa-shop"></i></span>
            <span class="ml-marketplace-prefab-card-body">
              <strong>{{name}}</strong>
              {{#if shopkeeper}}<small>{{shopkeeper}}</small>{{/if}}
            </span>
            <span class="ml-marketplace-prefab-match-count">{{matchedCount}} items</span>
          </button>
        {{else}}
        <div class="ml-empty-message ml-marketplace-shop-empty">
            No prefab stores currently have at least 8 matching items in the supported enabled compendiums.
          </div>
        {{/each}}
      </div>
    </section>
    {{/unless}}
  </aside>

  <main class="ml-marketplace-shop-editor-panel">
    {{#if selected}}
      <form data-shop-form>
        <header class="ml-marketplace-shop-editor-header">
          <div><h2>{{selected.name}}</h2><p>{{#if selected.isDraft}}Unsaved {{/if}}{{selected.type}} shop</p></div>
        <div class="ml-actions ml-marketplace-shop-actions ml-marketplace-shop-editor-actions">
            {{#unless selected.isDraft}}
              <button type="button" data-action="placeShop"><i class="fa-solid fa-location-dot"></i> Place on Scene</button>
              <button type="button" data-action="restockShop"><i class="fa-solid fa-rotate"></i> Restock Now</button>
            {{/unless}}
            <button type="button" data-action="saveShop" class="primary"><i class="fa-solid fa-floppy-disk"></i> {{#if selected.isDraft}}Save New Shop{{else}}Save{{/if}}</button>
          </div>
        </header>

        <div class="ml-marketplace-shop-editor-scroll" data-ml-scroll-key="shop-editor">
          <div class="ml-marketplace-shop-section-grid">
          <section class="ml-surface ml-stack ml-marketplace-shop-config-card">
            <h3>Identity & Access</h3>
            <label>Name <input type="text" name="name" value="{{selected.name}}"></label>
            <label>Token Image
              <div class="ml-marketplace-file-picker-row">
                <input type="text" name="img" value="{{selected.img}}">
                <button type="button" data-action="browseImage" title="Browse Foundry files"><i class="fa-solid fa-folder-open"></i></button>
              </div>
            </label>
            <div class="ml-marketplace-inline-checks">
              <label><input type="checkbox" name="allowBuying" {{#if selected.allowBuying}}checked{{/if}}> Players can buy</label>
              <label class="ml-check"><input type="checkbox" name="allowSelling" {{#if selected.allowSelling}}checked{{/if}}><span>Player can sell</span></label>
            </div>
          </section>

          <section class="ml-surface ml-stack ml-marketplace-shop-config-card">
            <h3>Pricing & Reputation</h3>
            <label>Party Reputation
              <select name="reputation">{{#each selected.reputations}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>
            <div class="ml-marketplace-two-column-fields">
              <label>Buy Multiplier <input type="number" name="buyModifier" min="0" step="0.05" value="{{selected.buyModifier}}"></label>
              <label>Base Sell Rate <input type="number" name="sellModifier" min="0" step="0.05" value="{{selected.sellModifier}}"></label>
            </div>
          </section>

          <section class="ml-surface ml-stack ml-marketplace-shop-config-card">
            <h3>Location & Capability</h3>
            <label>Morelord Location
              <select name="locationId">{{#each selected.locations}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
            </label>
            <label>Maximum Normal Rarity
              <select name="capabilityTier">{{#each selected.capabilityTiers}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>
          </section>

          <section class="ml-surface ml-stack ml-marketplace-shop-config-card">
            <h3>Inventory</h3>
            <label><span>Stock Plan</span>
              <select name="stockPlan">{{#each selected.stockPlans}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>

            <div class="ml-stack" data-gap="2" data-random-stock>
            <strong>Different products per rarity</strong>
            <div class="ml-marketplace-stock-counts">
              <label>Common <input type="number" name="stockCommon" min="0" value="{{selected.randomInventory.counts.common}}"></label>
              <label>Uncommon <input type="number" name="stockUncommon" min="0" value="{{selected.randomInventory.counts.uncommon}}"></label>
              <label>Rare <input type="number" name="stockRare" min="0" value="{{selected.randomInventory.counts.rare}}"></label>
              <label>Very Rare <input type="number" name="stockVeryrare" min="0" value="{{selected.randomInventory.counts.veryrare}}"></label>
              <label>Legendary <input type="number" name="stockLegendary" min="0" value="{{selected.randomInventory.counts.legendary}}"></label>
            </div>
            </div>
          </section>


          <section class="ml-surface ml-stack ml-marketplace-shop-config-card ml-marketplace-shop-config-wide">
            <h3>Products</h3>
            <label class="ml-check"><input type="checkbox" name="excludeMagical" {{#if selected.excludeMagical}}checked{{/if}}><span>Exclude magical items</span></label>
            <label class="ml-check"><input type="checkbox" name="exclusivelyMagical" {{#if selected.exclusivelyMagical}}checked{{/if}}><span>Exclusively magical items</span></label>
            <div class="ml-marketplace-option-columns">
              <div><strong>Item Options</strong>{{#each selected.itemTypeOptions}}<label><input type="checkbox" name="itemOptions" value="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
              <div><strong>Rarities</strong>{{#each selected.rarityOptions}}<label><input type="checkbox" name="rarities" value="{{key}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}</div>
            </div>
          </section>

          <section class="ml-surface ml-stack ml-marketplace-shop-config-card ml-marketplace-shop-config-wide">
            <div class="ml-section-heading" data-actions>
              <div><h3>Items the shop will buy <span class="ml-badge">{{selected.purchaseItems.length}}</span></h3></div>
              {{#unless selected.isDraft}}<div class="ml-actions"><button type="button" data-action="openInventoryLookup" data-lookup-target="purchase"><i class="fa-solid fa-plus"></i> Add Item</button></div>{{/unless}}
            </div>

            <div class="ml-stack" data-gap="2">
            {{#each selected.purchaseItems}}
              <div class="ml-card ml-item-row">
                <img src="{{img}}" alt="">
                <div class="ml-stack" data-gap="1"><a class="content-link ml-item-link" data-link data-uuid="{{uuid}}" title="Open {{name}} from its compendium">{{name}}</a>{{#if source}}<small>{{source}} · {{rarityLabel}} {{typeLabel}}</small>{{/if}}</div>
                <button type="button" class="ml-icon-button" data-action="removePurchaseItem" data-item-uuid="{{uuid}}" aria-label="Remove {{name}} from purchase items"><i class="fa-solid fa-trash"></i></button>
              </div>
            {{else}}<p class="ml-empty-message">No specific purchase items configured.</p>{{/each}}
            </div>
          </section>

          <section class="ml-surface ml-stack ml-marketplace-shop-config-card ml-marketplace-shop-config-wide">
            <div class="ml-section-heading" data-actions>
              <div><h3>Current Inventory <span class="ml-badge">{{selected.inventoryCount}}</span></h3></div>
              {{#unless selected.isDraft}}<div class="ml-actions"><button type="button" data-action="openInventoryLookup"><i class="fa-solid fa-plus"></i> Add Item</button></div>{{/unless}}
            </div>
            <div class="ml-stack" data-gap="2">
              {{#each selected.inventory}}
                <article class="ml-card ml-item-row">
                  <img src="{{img}}" alt="">
                  <div class="ml-stack" data-gap="1">
                    <a class="content-link ml-item-link" data-link data-uuid="{{uuid}}" title="Open {{name}} from its compendium">{{name}}</a>
                    {{#if isManualStock}}<span class="ml-badge" data-tone="info"><i class="fa-solid fa-thumbtack" aria-hidden="true"></i> Manual</span>{{/if}}
                    <small>{{source}} · {{rarityLabel}} {{typeLabel}}</small>
                  </div>
                  {{#if finite}}
                    {{> "modules/morelord-core/templates/components/quantity-controls.hbs" action="adjustInventoryQuantity" stockKey=stockKey name=name quantity=quantity increaseEnabled=true}}
                  {{else}}
                    <span class="ml-badge" title="This listing is unlimited"><i class="fa-solid fa-infinity"></i> Unlimited</span>
                  {{/if}}
                  {{#unless ../selected.isDraft}}<button type="button" class="ml-icon-button" data-action="removeInventoryItem" data-stock-key="{{packId}}:{{documentId}}" aria-label="Remove {{name}} from this shop" title="Remove {{name}} from this shop"><i class="fa-solid fa-trash"></i></button>{{/unless}}
                </article>
              {{else}}
          <div class="ml-empty-message ml-marketplace-shop-empty">This shop currently has no available inventory. Add an item or restock it.</div>
              {{/each}}
            </div>
          </section>
          </div>

          {{#unless selected.isDraft}}<footer class="ml-marketplace-shop-editor-footer"><button type="button" data-action="exportShop"><i class="fa-solid fa-file-export"></i> Export Shop</button><button type="button" data-action="deleteShop"><i class="fa-solid fa-trash"></i> Delete Shop</button></footer>{{/unless}}
        </div>
      </form>
    {{else}}
<div class="ml-empty-state ml-marketplace-shop-editor-empty"><i class="fa-solid fa-shop-lock"></i><h2>No Shop Selected</h2></div>
    {{/if}}
  </main>
</section>
