<section class="mlm-shell">
  <header class="mlm-market-header">
    <div class="mlm-brand-row">
      <div class="mlm-brand">
        <i class="fa-solid fa-store"></i>

        <div>
          <h1>Morelord Marketplace</h1>
          <span>Buy, sell, and manage adventuring gear</span>
        </div>
      </div>
    </div>

    {{#if actor}}
      <div class="mlm-shopper-card">
        <div class="mlm-shopper-identity">
          <img
            src="{{tokenImg}}"
            alt="{{actor.name}}"
            class="mlm-shopper-portrait">

          <div class="mlm-shopper-copy">
            <span class="mlm-shopper-label">
              {{#if isGM}}
                Marketplace for
              {{else}}
                Shopping as
              {{/if}}
            </span>

            <strong>{{actor.name}}</strong>
          </div>
        </div>

        <div class="mlm-shopper-wallet">
          <i class="fa-solid fa-coins"></i>

          <div>
            <span>Available Coin</span>
            <strong>{{{currency}}}</strong>
          </div>
        </div>
      </div>
    {{/if}}

    <nav class="mlm-tabs" aria-label="Marketplace sections">
      <button
        type="button"
        class="mlm-tab-button {{#if isSellTab}}active{{/if}}"
        data-action="switchTab"
        data-tab="sell"
        {{#if isLoadingBuy}}disabled{{/if}}>
        <i class="fa-solid fa-hand-holding-dollar"></i>
        <span>Sell</span>
      </button>

      <button
        type="button"
        class="mlm-tab-button {{#if isBuyTab}}active{{/if}}"
        data-action="switchTab"
        data-tab="buy"
        {{#if isLoadingBuy}}disabled{{/if}}>
        {{#if isLoadingBuy}}
          <i class="fa-solid fa-spinner fa-spin"></i>
          <span>Loading…</span>
        {{else}}
          <i class="fa-solid fa-cart-shopping"></i>
          <span>Buy</span>
        {{/if}}
      </button>
    </nav>
  </header>

  {{#if error}}
    <div class="mlm-error">{{error}}</div>
  {{else}}
    {{#if isSellTab}}
      {{> "modules/morelord-marketplace/templates/parts/sell-tab.hbs"}}
    {{/if}}

    {{#if isBuyTab}}
      {{#if isLoadingBuy}}
        <section class="mlm-buy-loading" aria-live="polite" aria-busy="true">
          <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
          <div>
            <strong>Loading marketplace items…</strong>
            <span>Reading and processing the selected item compendiums.</span>
          </div>
        </section>
      {{else}}
        {{> "modules/morelord-marketplace/templates/parts/buy-tab.hbs"}}
      {{/if}}
    {{/if}}
  {{/if}}
</section>
