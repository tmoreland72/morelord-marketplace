<section class="mlm-shell">
  <header class="mlm-market-header">
    <div class="mlm-brand-row">
      <div class="mlm-brand">
        {{#if isShop}}
          <img class="mlm-shop-brand-image" src="{{shopImg}}" alt="{{shopName}}">
        {{else}}
          <i class="fa-solid fa-store"></i>
        {{/if}}

        <div>
          <h1>{{#if isShop}}{{shopName}}{{else}}Morelord Marketplace{{/if}}</h1>
          <span>{{#if isShop}}Morelord Marketplace Vendor · Reputation: {{shopReputation}}{{else}}Buy, sell, and manage adventuring gear{{/if}}</span>
        </div>
      </div>
      {{#if isShop}}
        <div class="mlm-shop-header-actions">
          <button type="button" data-action="refreshShop" title="Refresh shop inventory and clear the cart"><i class="fa-solid fa-rotate"></i> Refresh</button>
          {{#if canManageShops}}<button type="button" class="mlm-manage-shops-button" data-action="manageShops"><i class="fa-solid fa-shop"></i> Manage Shops</button>{{/if}}
        </div>
      {{else if canManageShops}}
        <button type="button" class="mlm-manage-shops-button" data-action="manageShops"><i class="fa-solid fa-shop"></i> Manage Shops</button>
      {{/if}}
    </div>

    <div class="mlm-shopper-card mlm-shop-context-card">
        <div class="mlm-shop-selector-block">
          <span class="mlm-shopper-label">Shopping As</span>
          {{#if showShopperSelector}}
            <select data-mlm-shopper-select aria-label="Shopping As">
              {{#each shopperOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} · {{typeLabel}}</option>
              {{/each}}
            </select>
          {{else if actor}}
            <strong>{{actor.name}}</strong>
          {{else}}
            <strong>No character selected</strong>
          {{/if}}
          <small>Purchases go to and sales come from this actor or group.</small>
        </div>

        <div class="mlm-shop-selector-block mlm-funding-selector-block">
          <span class="mlm-shopper-label">Paying As</span>
          {{#if showFundingSelector}}
            <select data-mlm-funding-select aria-label="Paying As">
              {{#each fundingOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if typeLabel}} · {{typeLabel}}{{/if}}</option>
              {{/each}}
            </select>
          {{else}}
            <strong>No eligible funds actor</strong>
          {{/if}}
          <small>Purchase coin is deducted from this actor or group.</small>
        </div>

        <div class="mlm-shopper-wallet">
          <i class="fa-solid fa-coins"></i>
          <div>
            <span>Available Coin</span>
            <strong>{{#if fundingActor}}{{{currency}}}{{else}}—{{/if}}</strong>
          </div>
        </div>
      </div>

    {{#if shopperNotice}}
      <div class="mlm-shopper-notice">
        <i class="fa-solid fa-user-tag"></i>
        <span>{{shopperNotice}}</span>
      </div>
    {{/if}}

    {{#if shopStale}}
      <div class="mlm-shopper-notice mlm-shop-stale-notice">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>This shop changed after you opened it. Refresh the shop before purchasing. Refreshing clears the cart.</span>
      </div>
    {{/if}}

    <nav class="mlm-tabs" aria-label="Marketplace sections">
      <button
        type="button"
        class="mlm-tab-button {{#if isSellTab}}active{{/if}}"
        data-action="switchTab"
        data-tab="sell"
        {{#if isLoadingBuy}}disabled{{/if}}>
        <i class="fa-solid fa-hand-holding-dollar"></i>
        <span>Sell</span>
      </button>

      <button
        type="button"
        class="mlm-tab-button {{#if isBuyTab}}active{{/if}}"
        data-action="switchTab"
        data-tab="buy"
        {{#if isLoadingBuy}}disabled{{/if}}>
        {{#if isLoadingBuy}}
          <i class="fa-solid fa-spinner fa-spin"></i>
          <span>Loading…</span>
        {{else}}
          <i class="fa-solid fa-cart-shopping"></i>
          <span>Buy</span>
        {{/if}}
      </button>
    </nav>
  </header>

  {{#if error}}
    <div class="mlm-error">{{error}}</div>
  {{else}}
    {{#if isSellTab}}
      {{> "modules/morelord-marketplace/templates/parts/sell-tab.hbs"}}
    {{/if}}

    {{#if isBuyTab}}
      {{#if isLoadingBuy}}
        <section class="mlm-buy-loading" aria-live="polite" aria-busy="true">
          <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
          <div>
            <strong>Loading marketplace items…</strong>
            <span>Reading and processing the selected item compendiums.</span>
          </div>
        </section>
      {{else}}
        {{> "modules/morelord-marketplace/templates/parts/buy-tab.hbs"}}
      {{/if}}
    {{/if}}
  {{/if}}
</section>
