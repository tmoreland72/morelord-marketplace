<section class="ml-app ml-app-shell ml-marketplace-app ml-marketplace-shell" data-ml-responsive>
  <header class="ml-marketplace-market-header">
    {{#if isShop}}
    <div class="ml-hero ml-marketplace-hero ml-marketplace-brand-row">
      <div class="ml-hero__body ml-marketplace-brand">
        {{#if isShop}}
          <img class="ml-marketplace-shop-brand-image" src="{{shopImg}}" alt="{{shopName}}">
        {{else}}
          <i class="fa-solid fa-store"></i>
        {{/if}}

        <div>
          <h1>{{#if isShop}}{{shopName}}{{else}}Morelord Marketplace{{/if}}</h1>
          <p>{{#if isShop}}Morelord Marketplace Vendor · Reputation: {{shopReputation}}{{else}}Buy, sell, and manage adventuring gear{{/if}}</p>
        </div>
      </div>
      {{#if isShop}}
        <div class="ml-actions ml-marketplace-header-actions ml-marketplace-shop-header-actions">
          <button type="button" data-action="refreshShop" title="Refresh shop inventory and clear the cart"><i class="fa-solid fa-rotate"></i> Refresh</button>
          {{#if canManageShops}}<button type="button" class="ml-marketplace-manage-shops-button" data-action="manageShops"><i class="fa-solid fa-shop"></i> Manage Shops</button>{{/if}}
          {{#if canManageLocations}}<button type="button" data-action="manageLocations"><i class="fa-solid fa-map-location-dot"></i> Manage Locations</button>{{/if}}
        </div>
      {{else}}
        <div class="ml-actions">
          {{#if canManageShops}}<button type="button" class="ml-marketplace-manage-shops-button" data-action="manageShops"><i class="fa-solid fa-shop"></i> Manage Shops</button>{{/if}}
          {{#if canManageLocations}}<button type="button" data-action="manageLocations"><i class="fa-solid fa-map-location-dot"></i> Manage Locations</button>{{/if}}
        </div>
      {{/if}}
    </div>

    {{else}}
    <div class="ml-hero">
      <i class="fa-solid fa-store ml-hero__icon"></i>
      <div class="ml-hero__body"><h1>Morelord Marketplace</h1><p>Buy, sell, and manage adventuring gear.</p></div>
      <div class="ml-actions"><button type="button" data-action="openDocumentation"><i class="fa-solid fa-book-open"></i> Documentation</button></div>
    </div>
    <div class="ml-actions">
      {{#if canManageShops}}<button type="button" class="ml-marketplace-manage-shops-button" data-action="manageShops"><i class="fa-solid fa-shop"></i> Manage Shops</button>{{/if}}
      {{#if canManageLocations}}<button type="button" data-action="manageLocations"><i class="fa-solid fa-map-location-dot"></i> Manage Locations</button>{{/if}}
    </div>
    {{#if isGM}}<div class="ml-horizontal-scroll"><label class="ml-check"><input type="checkbox" data-action="toggleGlobalRates" {{#if ignoreGlobalRates}}checked{{/if}}><span>Temporarily ignore buy and sell rates (both ×1)</span></label></div>{{/if}}
    {{#if ignoreGlobalRates}}<p class="notes">Global rate override is active: purchases and sales use full list price. Shop rates are independent.</p>{{/if}}
    {{/if}}

  </header>

    <nav class="ml-tabs" role="tablist" aria-label="Marketplace sections">
      <a id="ml-marketplace-tab-sell" role="tab" tabindex="{{#if isSellTab}}0{{else}}-1{{/if}}" aria-selected="{{#if isSellTab}}true{{else}}false{{/if}}" aria-controls="ml-marketplace-panel" aria-disabled="{{#if isLoadingBuy}}true{{else}}false{{/if}}" data-action="switchTab" data-tab="sell"><i class="fa-solid fa-hand-holding-dollar"></i> Sell</a>
      {{#unless isShop}}<a id="ml-marketplace-tab-transfer" role="tab" tabindex="{{#if isTransferTab}}0{{else}}-1{{/if}}" aria-selected="{{#if isTransferTab}}true{{else}}false{{/if}}" aria-controls="ml-marketplace-panel" aria-disabled="{{#if isLoadingBuy}}true{{else}}false{{/if}}" data-action="switchTab" data-tab="transfer"><i class="fa-solid fa-right-left"></i> Transfer</a>{{/unless}}
      <a id="ml-marketplace-tab-buy" role="tab" tabindex="{{#if isBuyTab}}0{{else}}-1{{/if}}" aria-selected="{{#if isBuyTab}}true{{else}}false{{/if}}" aria-controls="ml-marketplace-panel" aria-disabled="{{#if isLoadingBuy}}true{{else}}false{{/if}}" data-action="switchTab" data-tab="buy"><i class="fa-solid fa-cart-shopping"></i> Buy</a>
      {{#unless isShop}}<a id="ml-marketplace-tab-wishlist" role="tab" tabindex="{{#if isWishlistTab}}0{{else}}-1{{/if}}" aria-selected="{{#if isWishlistTab}}true{{else}}false{{/if}}" aria-controls="ml-marketplace-panel" aria-disabled="{{#if isLoadingBuy}}true{{else}}false{{/if}}" data-action="switchTab" data-tab="wishlist"><i class="fa-solid fa-heart"></i> Wishlist {{#if wishlistCount}}<span class="ml-badge">{{wishlistCount}}</span>{{/if}}</a>{{/unless}}
    </nav>

  <section id="ml-marketplace-panel" class="ml-stack" data-gap="3" role="tabpanel" aria-labelledby="ml-marketplace-tab-{{activeTab}}">
  {{#unless isWishlistTab}}
    {{#if isTransferTab}}{{> "modules/morelord-marketplace/templates/parts/transfer-context.hbs"}}{{else}}{{> "modules/morelord-marketplace/templates/parts/shopping-context.hbs"}}{{/if}}
  {{/unless}}
  {{#if error}}
    <div class="ml-marketplace-error">{{error}}</div>
  {{else}}
    {{#if isTransferTab}}{{> "modules/morelord-marketplace/templates/parts/transfer-tab.hbs"}}{{/if}}
    {{#if isSellTab}}
      {{> "modules/morelord-marketplace/templates/parts/sell-tab.hbs"}}
    {{/if}}

    {{#if isBuyTab}}
      {{#if isLoadingBuy}}
        <section class="ml-surface ml-stack" data-gap="3" aria-live="polite" aria-busy="true">
          <div class="ml-section-heading"><div><h2>Buy</h2><p>Browse available items and add purchases to your cart.</p></div></div>
          <div class="ml-marketplace-buy-loading">
          <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
          <div>
            <strong>Loading marketplace items…</strong>
            <span>Reading and processing the selected item compendiums.</span>
          </div>
          </div>
        </section>
      {{else}}
        {{> "modules/morelord-marketplace/templates/parts/buy-tab.hbs"}}
      {{/if}}
    {{/if}}

    {{#if isWishlistTab}}
      {{#if isLoadingBuy}}
        <section class="ml-surface ml-stack" data-gap="3" aria-live="polite" aria-busy="true">
          <div class="ml-section-heading"><div><h2>Wishlist</h2><p>Review saved items for the selected shopper.</p></div></div>
          <div class="ml-marketplace-buy-loading">
          <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
          <div><strong>Loading your wishlist…</strong><span>Checking current catalog availability.</span></div>
          </div>
        </section>
      {{else}}
        {{> "modules/morelord-marketplace/templates/parts/wishlist-tab.hbs"}}
      {{/if}}
    {{/if}}
  {{/if}}
  </section>
</section>
