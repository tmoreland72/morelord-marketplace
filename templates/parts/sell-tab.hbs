<section class="ml-surface ml-stack ml-marketplace-tab ml-marketplace-sell-tab" data-gap="3">
  <div class="ml-section-heading"><div><h2>Sell</h2><p>Choose items from the shopper's inventory to sell.</p></div></div>
    <div class="ml-marketplace-sell-layout">
    {{> "modules/morelord-marketplace/templates/parts/inventory-table.hbs" rows=sellItems scrollKey="sell-results"}}
    <aside class="ml-marketplace-cart-panel">
      <div class="ml-marketplace-cart-heading"><div class="ml-marketplace-cart-title"><i class="fa-solid fa-cart-shopping"></i><strong>Sell Cart</strong></div><span class="ml-marketplace-cart-count">{{sellCartCount}}</span></div>
      <div class="ml-marketplace-cart-items">
        {{#each sellCartItems}}
          <div class="ml-marketplace-cart-line">
            <img src="{{img}}" alt="{{name}}" data-link data-uuid="{{uuid}}">
            <div class="ml-marketplace-cart-line-details">
              <a class="content-link ml-marketplace-cart-item-name" data-link data-uuid="{{uuid}}">{{name}}</a>
              <div class="ml-marketplace-cart-line-pricing"><span>{{sellPrice}} each</span><strong>{{lineTotal}}</strong></div>
              <div class="ml-marketplace-cart-quantity-row"><span>Qty</span>
                {{> "modules/morelord-core/templates/components/quantity-controls.hbs" action="adjustCartQuantity" clearAction="adjustCartQuantity" cartType="sell" itemId=ownedItemId name=name quantity=quantity increaseEnabled=canAddToSellCart disabled=../isCheckingOut classes="ml-marketplace-quantity-stepper ml-marketplace-cart-stepper" quantityClass="ml-marketplace-cart-qty"}}
              </div>
            </div>
          </div>
        {{else}}
          <div class="ml-empty-state ml-marketplace-cart-empty"><i class="fa-solid fa-basket-shopping"></i><span>Your sell cart is empty.</span></div>
        {{/each}}
      </div>
      <div class="ml-marketplace-cart-footer">
        <div><span>Sale Total</span><strong>{{sellCartTotal}}</strong></div>
        <button type="button" class="primary" data-action="checkoutSellCart" {{#unless canCheckoutSell}}disabled{{/unless}}>{{#if isCheckingOut}}<i class="fa-solid fa-spinner fa-spin"></i> Selling…{{else}}<i class="fa-solid fa-coins"></i> Sell Cart{{/if}}</button>
        {{#if sellCartCount}}<button type="button" data-action="clearSellCart"><i class="fa-solid fa-trash"></i> Clear Cart</button>{{/if}}
      </div>
    </aside>
    </div>
</section>
