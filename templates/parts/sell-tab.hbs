<section class="mlm-tab mlm-sell-tab">
    <div class="mlm-sell-heading">
        <h3>Available Inventory</h3>
        <label class="mlm-sell-sort">
            <span>Sort by</span>
            <select data-mlm-sell-sort aria-label="Sort sell inventory">
                {{#each sellSortOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </label>
    </div>

    <div class="mlm-table-container">
    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Type</th>
                <th>Qty</th>
                <th>List Price</th>
                <th>Sell Price</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each sellItems}}
            <tr>
                <td>
                    <div class="mlm-item-cell">
                        <img src="{{img}}" alt="{{name}}" />
                        <a class="content-link"
                            data-link
                            data-uuid="{{uuid}}">
                            {{name}}
                        </a>
                    </div>
                </td>
                <td>{{type}}</td>
                <td>{{quantity}}</td>
                <td>{{listPrice}}</td>
                <td>{{sellPrice}}</td>
                <td>
                    <div class="mlm-actions">
                        <button type="button" data-action="sellOne" data-item-id="{{ownedItemId}}" title="Sell One" {{#unless ../canSell}}disabled{{/unless}}>
                        <i class="fa-solid fa-coin"></i>
                        </button>

                        <button type="button" data-action="sellAll" data-item-id="{{ownedItemId}}" title="Sell All" {{#unless ../canSell}}disabled{{/unless}}>
                        <i class="fa-solid fa-sack-dollar"></i>
                        </button>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    </div>
</section>
