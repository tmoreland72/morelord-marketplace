<section class="ml-marketplace-tab ml-marketplace-sell-tab">
    <div class="ml-marketplace-sell-heading">
        <h3>Available Inventory</h3>
        <label class="ml-marketplace-sell-sort">
            <span>Sort by</span>
            <select data-ml-marketplace-sell-sort aria-label="Sort sell inventory">
                {{#each sellSortOptions}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
            </select>
        </label>
    </div>

    <div class="ml-marketplace-sell-layout">
    <div class="ml-marketplace-table-container" data-ml-marketplace-preserve-scroll="sell-results">
    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th>List Price</th>
                <th>Sell Price</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {{#each sellItems}}
            <tr>
                <td>
                    <div class="ml-marketplace-item-cell">
                        <img src="{{img}}" alt="{{name}}" />
                        <a class="content-link"
                            data-link
                            data-uuid="{{uuid}}">
                            {{name}}
                        </a>
                    </div>
                </td>
                <td>{{quantity}}</td>
                <td>{{listPrice}}</td>
                <td>{{sellPrice}}</td>
                <td>
            <div class="ml-actions ml-marketplace-row-actions ml-marketplace-actions">
                        <button type="button" data-action="sellOne" data-item-id="{{ownedItemId}}" title="Add one to sell cart" {{#unless canAddToSellCart}}disabled{{/unless}}>
                        <i class="fa-solid fa-coin"></i>
                        </button>

                        <button type="button" data-action="sellAll" data-item-id="{{ownedItemId}}" title="Add all to sell cart" {{#unless canAddToSellCart}}disabled{{/unless}}>
                        <i class="fa-solid fa-sack-dollar"></i>
                        </button>
                        {{#if cartQty}}<span class="ml-marketplace-cart-qty">{{cartQty}}</span>{{/if}}
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    </div>
    <aside class="ml-marketplace-cart-panel">
      <div class="ml-marketplace-cart-heading"><div class="ml-marketplace-cart-title"><i class="fa-solid fa-cart-shopping"></i><strong>Sell Cart</strong></div><span class="ml-marketplace-cart-count">{{sellCartCount}}</span></div>
      <div class="ml-marketplace-cart-items">
        {{#each sellCartItems}}
          <div class="ml-marketplace-cart-line">
            <img src="{{img}}" alt="{{name}}" data-link data-uuid="{{uuid}}">
            <div><a class="content-link ml-marketplace-cart-item-name" data-link data-uuid="{{uuid}}">{{name}}</a><span>{{quantity}} × {{sellPrice}}</span><small>{{lineTotal}}</small></div>
            <button type="button" data-action="removeSellFromCart" data-item-id="{{ownedItemId}}" title="Remove one"><i class="fa-solid fa-minus"></i></button>
          </div>
        {{else}}
          <div class="ml-empty-state ml-marketplace-cart-empty"><i class="fa-solid fa-basket-shopping"></i><span>Your sell cart is empty.</span></div>
        {{/each}}
      </div>
      <div class="ml-marketplace-cart-footer">
        <div><span>Sale Total</span><strong>{{sellCartTotal}}</strong></div>
        <button type="button" class="primary" data-action="checkoutSellCart" {{#unless canCheckoutSell}}disabled{{/unless}}>{{#if isCheckingOut}}<i class="fa-solid fa-spinner fa-spin"></i> Selling…{{else}}<i class="fa-solid fa-coins"></i> Sell Cart{{/if}}</button>
        {{#if sellCartCount}}<button type="button" data-action="clearSellCart"><i class="fa-solid fa-trash"></i> Clear Cart</button>{{/if}}
      </div>
    </aside>
    </div>
</section>
