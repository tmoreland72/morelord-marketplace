<section class="ml-marketplace-tab ml-marketplace-buy-tab">
  <div class="ml-marketplace-buy-heading">
    <div>
      <h3>Buy Items</h3>
      <span class="ml-marketplace-result-count">{{buyResultCount}} items</span>
    </div>

    {{#if hasBuyFilters}}
      <button type="button" class="ml-marketplace-clear-all" data-action="clearBuyFilters">
        <i class="fa-solid fa-filter-circle-xmark"></i>
        Clear all filters
      </button>
    {{/if}}
  </div>

  <div class="ml-marketplace-buy-layout">
    <aside class="ml-marketplace-filter-sidebar" aria-label="Buy item filters" data-ml-marketplace-preserve-scroll="buy-filters">
      <div class="ml-marketplace-filter-search">
        <label for="ml-marketplace-buy-search">Search</label>
        <div class="ml-marketplace-search">
          <input id="ml-marketplace-buy-search" type="text" name="search" value="{{filters.search}}" placeholder="Search items...">
          <button type="button" class="ml-marketplace-clear-search" title="Clear Search" data-action="clearSearch">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <div class="ml-marketplace-filter-key" aria-label="Filter state key">
        <span title="No filter"><i class="fa-regular fa-square"></i> Any</span>
        <span title="Include matching items"><i class="fa-solid fa-square-check"></i> Include</span>
        <span title="Exclude matching items"><i class="fa-solid fa-square-minus"></i> Exclude</span>
      </div>

      <section class="ml-marketplace-filter-group ml-marketplace-affordability-group">
        <h4>Affordability</h4>
        <button
          type="button"
          class="ml-marketplace-filter-option-button {{#if filters.affordableOnly}}active{{/if}}"
          data-action="toggleAffordable"
          title="Only show items this character can afford">
          <i class="{{#if filters.affordableOnly}}fa-solid fa-square-check{{else}}fa-regular fa-square{{/if}}"></i>
          <span>Only show what I can afford</span>
        </button>
      </section>

      <section class="ml-marketplace-filter-group">
        <h4>Price (gp)</h4>
        <div class="ml-marketplace-price-range">
          <input type="number" name="minPrice" min="0" step="1" value="{{filters.minPrice}}" placeholder="Min" data-filter-control>
          <span>to</span>
          <input type="number" name="maxPrice" min="0" step="1" value="{{filters.maxPrice}}" placeholder="Max" data-filter-control>
        </div>
      </section>

      <section class="ml-marketplace-filter-group">
        <h4>Item Type</h4>
        <div class="ml-marketplace-filter-options">
          {{#each buyFacets.types}}
            <button
              type="button"
              class="ml-marketplace-tristate-filter state-{{state}}"
              data-action="cycleFacetFilter"
              data-filter-group="types"
              data-filter-value="{{value}}"
              title="{{stateTitle}}">
              {{#if isIncluded}}
                <i class="fa-solid fa-square-check"></i>
              {{else if isExcluded}}
                <i class="fa-solid fa-square-minus"></i>
              {{else}}
                <i class="fa-regular fa-square"></i>
              {{/if}}
              <span>{{label}}</span>
              <small>{{count}}</small>
            </button>
          {{/each}}
        </div>
      </section>

      {{#if showSubtypeFilters}}
        <section class="ml-marketplace-filter-group">
          <h4>Category</h4>
          <div class="ml-marketplace-filter-options">
            {{#each buyFacets.subtypes}}
              <button
                type="button"
                class="ml-marketplace-tristate-filter state-{{state}}"
                data-action="cycleFacetFilter"
                data-filter-group="subtypes"
                data-filter-value="{{value}}"
                title="{{stateTitle}}">
                {{#if isIncluded}}
                  <i class="fa-solid fa-square-check"></i>
                {{else if isExcluded}}
                  <i class="fa-solid fa-square-minus"></i>
                {{else}}
                  <i class="fa-regular fa-square"></i>
                {{/if}}
                <span>{{label}}</span>
                <small>{{count}}</small>
              </button>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if showWeaponFilters}}
        <section class="ml-marketplace-filter-group">
          <h4>Weapon Class</h4>
          <div class="ml-marketplace-filter-options">
            {{#each buyFacets.weaponCategories}}
              <button type="button" class="ml-marketplace-tristate-filter state-{{state}}" data-action="cycleFacetFilter" data-filter-group="weaponCategories" data-filter-value="{{value}}" title="{{stateTitle}}">
                {{#if isIncluded}}<i class="fa-solid fa-square-check"></i>{{else if isExcluded}}<i class="fa-solid fa-square-minus"></i>{{else}}<i class="fa-regular fa-square"></i>{{/if}}
                <span>{{label}}</span><small>{{count}}</small>
              </button>
            {{/each}}
          </div>
        </section>

        <section class="ml-marketplace-filter-group">
          <h4>Weapon Range</h4>
          <div class="ml-marketplace-filter-options">
            {{#each buyFacets.weaponRanges}}
              <button type="button" class="ml-marketplace-tristate-filter state-{{state}}" data-action="cycleFacetFilter" data-filter-group="weaponRanges" data-filter-value="{{value}}" title="{{stateTitle}}">
                {{#if isIncluded}}<i class="fa-solid fa-square-check"></i>{{else if isExcluded}}<i class="fa-solid fa-square-minus"></i>{{else}}<i class="fa-regular fa-square"></i>{{/if}}
                <span>{{label}}</span><small>{{count}}</small>
              </button>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if showPropertyFilters}}
        <section class="ml-marketplace-filter-group">
          <h4>Weapon Properties</h4>
          <div class="ml-marketplace-filter-options">
            {{#each buyFacets.properties}}
              <button
                type="button"
                class="ml-marketplace-tristate-filter state-{{state}}"
                data-action="cycleFacetFilter"
                data-filter-group="properties"
                data-filter-value="{{value}}"
                title="{{stateTitle}}">
                {{#if isIncluded}}
                  <i class="fa-solid fa-square-check"></i>
                {{else if isExcluded}}
                  <i class="fa-solid fa-square-minus"></i>
                {{else}}
                  <i class="fa-regular fa-square"></i>
                {{/if}}
                <span>{{label}}</span>
                <small>{{count}}</small>
              </button>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if showMasteryFilters}}
        <section class="ml-marketplace-filter-group">
          <h4>Weapon Masteries</h4>
          <div class="ml-marketplace-filter-options">
            {{#each buyFacets.masteries}}
              <button type="button" class="ml-marketplace-tristate-filter state-{{state}}" data-action="cycleFacetFilter" data-filter-group="masteries" data-filter-value="{{value}}" title="{{stateTitle}}">
                {{#if isIncluded}}<i class="fa-solid fa-square-check"></i>{{else if isExcluded}}<i class="fa-solid fa-square-minus"></i>{{else}}<i class="fa-regular fa-square"></i>{{/if}}
                <span>{{label}}</span><small>{{count}}</small>
              </button>
            {{/each}}
          </div>
        </section>
      {{/if}}

      <section class="ml-marketplace-filter-group">
        <h4>Rarity</h4>
        <div class="ml-marketplace-filter-options">
          {{#each buyFacets.rarities}}
            <button
              type="button"
              class="ml-marketplace-tristate-filter state-{{state}}"
              data-action="cycleFacetFilter"
              data-filter-group="rarities"
              data-filter-value="{{value}}"
              title="{{stateTitle}}">
              {{#if isIncluded}}
                <i class="fa-solid fa-square-check"></i>
              {{else if isExcluded}}
                <i class="fa-solid fa-square-minus"></i>
              {{else}}
                <i class="fa-regular fa-square"></i>
              {{/if}}
              <span>{{label}}</span>
              <small>{{count}}</small>
            </button>
          {{/each}}
        </div>
      </section>

      <section class="ml-marketplace-filter-group">
        <h4>Attunement</h4>
        <div class="ml-marketplace-filter-options">
          <label class="ml-marketplace-filter-option">
            <input type="radio" name="attunement" value="" data-filter-control {{#if attunementAny}}checked{{/if}}>
            <span>Any</span>
          </label>
          <label class="ml-marketplace-filter-option">
            <input type="radio" name="attunement" value="required" data-filter-control {{#if attunementRequired}}checked{{/if}}>
            <span>Required</span>
          </label>
          <label class="ml-marketplace-filter-option">
            <input type="radio" name="attunement" value="not-required" data-filter-control {{#if attunementNotRequired}}checked{{/if}}>
            <span>Not Required</span>
          </label>
        </div>
      </section>

      <section class="ml-marketplace-filter-group">
        <h4>Source</h4>
        <div class="ml-marketplace-filter-options ml-marketplace-source-options">
          {{#each buyFacets.sources}}
            <button
              type="button"
              class="ml-marketplace-tristate-filter state-{{state}}"
              data-action="cycleFacetFilter"
              data-filter-group="sources"
              data-filter-value="{{value}}"
              title="{{stateTitle}}">
              {{#if isIncluded}}
                <i class="fa-solid fa-square-check"></i>
              {{else if isExcluded}}
                <i class="fa-solid fa-square-minus"></i>
              {{else}}
                <i class="fa-regular fa-square"></i>
              {{/if}}
              <span title="{{label}}">{{label}}</span>
              <small>{{count}}</small>
            </button>
          {{/each}}
        </div>
      </section>
    </aside>

    <main class="ml-marketplace-buy-results">
      <div class="ml-marketplace-table-container" data-ml-marketplace-preserve-scroll="buy-results">
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Rarity</th>
              <th>List Price</th>
              <th>Selling Price</th>
              {{#unless isShop}}<th>Source</th>{{/unless}}
              {{#if isShop}}<th>Stock</th>{{/if}}
              <th aria-label="Actions"></th>
            </tr>
          </thead>
          <tbody>
            {{#each buyItems}}
              <tr>
                <td>
                  <div class="ml-marketplace-item-cell">
                    <img src="{{img}}" alt="{{name}}">
                    <a class="content-link" data-link data-uuid="{{uuid}}">{{name}}</a>
                  </div>
                </td>
                <td>{{rarityLabel}}</td>
                <td>{{listPrice}}</td>
                <td>{{buyPrice}}</td>
                {{#unless ../isShop}}<td title="{{packId}}">{{source}}</td>{{/unless}}
                {{#if ../isShop}}<td title="{{stockTitle}}">{{stockLabel}}</td>{{/if}}
                <td>
            <div class="ml-actions ml-marketplace-row-actions ml-marketplace-actions">
                    {{#unless ../isShop}}
                      <button type="button" class="ml-marketplace-wishlist-button {{#if isWishlisted}}active{{/if}}" title="{{#if isWishlisted}}On your wishlist{{else}}Add {{name}} to wishlist{{/if}}" data-action="addToWishlist" data-pack-id="{{packId}}" data-document-id="{{documentId}}" {{#if isWishlisted}}disabled{{/if}}>
                        <i class="{{#if isWishlisted}}fa-solid{{else}}fa-regular{{/if}} fa-heart"></i>
                      </button>
                    {{/unless}}
                    {{#if cartQty}}
                      <div class="ml-marketplace-quantity-stepper" aria-label="{{name}} cart quantity">
                        <button type="button" data-action="removeFromCart" data-cart-key="{{packId}}:{{documentId}}" title="Remove one {{name}} from cart"><i class="fa-solid fa-minus"></i></button>
                        <span class="ml-marketplace-cart-qty" aria-label="Quantity">{{cartQty}}</span>
                        <button type="button" data-action="buyItem" data-pack-id="{{packId}}" data-document-id="{{documentId}}" title="Add one {{name}} to cart" {{#unless canAddToCart}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
                      </div>
                    {{else}}
                      <button type="button" class="ml-marketplace-buy-button" title="Add {{name}} to cart" data-action="buyItem" data-pack-id="{{packId}}" data-document-id="{{documentId}}" {{#unless canAddToCart}}disabled{{/unless}}>
                        <i class="fa-solid fa-cart-plus"></i>
                      </button>
                    {{/if}}
                  </div>
                </td>
              </tr>
            {{else}}
              <tr>
                <td colspan="6" class="ml-marketplace-empty-results">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  No items match the selected filters.
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{#if buyResultCount}}
        <nav class="ml-marketplace-pagination" aria-label="Buy catalog pages">
          <button type="button" data-action="changeBuyPage" data-page="{{previousBuyPage}}" {{#unless hasPreviousBuyPage}}disabled{{/unless}} title="Previous page" aria-label="Previous page"><i class="fa-solid fa-chevron-left"></i></button>
          <span>Showing {{buyPageStart}}–{{buyPageEnd}} of {{buyResultCount}} · Page {{buyPage}} of {{buyPageCount}}</span>
          <button type="button" data-action="changeBuyPage" data-page="{{nextBuyPage}}" {{#unless hasNextBuyPage}}disabled{{/unless}} title="Next page" aria-label="Next page"><i class="fa-solid fa-chevron-right"></i></button>
        </nav>
      {{/if}}
    </main>

    <aside class="ml-marketplace-cart-panel">
        <div class="ml-marketplace-cart-heading">
          <div class="ml-marketplace-cart-title"><i class="fa-solid fa-cart-shopping"></i><strong>Cart</strong></div>
          <span class="ml-marketplace-cart-count">{{cartCount}}</span>
        </div>
        <div class="ml-marketplace-cart-items" data-ml-marketplace-preserve-scroll="buy-cart">
          {{#each cartItems}}
            <div class="ml-marketplace-cart-line">
              <img src="{{img}}" alt="{{name}}" data-link data-uuid="{{uuid}}" title="Open {{name}}">
              <div class="ml-marketplace-cart-line-details">
                <a class="content-link ml-marketplace-cart-item-name" data-link data-uuid="{{uuid}}">{{name}}</a>
                <div class="ml-marketplace-cart-line-pricing">
                  <span>{{buyPrice}} each</span>
                  <strong>{{lineTotal}}</strong>
                </div>
                <div class="ml-marketplace-cart-quantity-row">
                  <span>Qty</span>
                  <div class="ml-marketplace-quantity-stepper ml-marketplace-cart-stepper" aria-label="{{name}} cart quantity">
                    <button type="button" data-action="removeFromCart" data-cart-key="{{packId}}:{{documentId}}" title="Remove one {{name}} from cart"><i class="fa-solid fa-minus"></i></button>
                    <span class="ml-marketplace-cart-qty" aria-label="Quantity">{{quantity}}</span>
                    <button type="button" data-action="addToCart" data-pack-id="{{packId}}" data-document-id="{{documentId}}" title="Add one {{name}} to cart"><i class="fa-solid fa-plus"></i></button>
                  </div>
                </div>
              </div>
            </div>
          {{else}}
<div class="ml-empty-state ml-marketplace-cart-empty"><i class="fa-solid fa-basket-shopping"></i><span>Your cart is empty.</span></div>
          {{/each}}
        </div>
        <div class="ml-marketplace-cart-footer">
          <div><span>Purchase Total</span><strong>{{cartTotal}}</strong></div>
          <div><span>Remaining After Purchase</span><strong>{{cartRemaining}}</strong></div>
          <button type="button" class="primary" data-action="checkoutCart" {{#unless canCheckout}}disabled{{/unless}}>
            {{#if isCheckingOut}}<i class="fa-solid fa-spinner fa-spin"></i> Purchasing…{{else}}<i class="fa-solid fa-coins"></i> Purchase{{/if}}
          </button>
          {{#if cartCount}}<button type="button" data-action="clearCart"><i class="fa-solid fa-trash"></i> Clear Cart</button>{{/if}}
        </div>
    </aside>
  </div>
</section>
