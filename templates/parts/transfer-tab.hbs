<section class="ml-surface ml-stack" data-gap="3">
  <div class="ml-section-heading"><div><h2>Transfer</h2><p>Send inventory items to another character or Group.</p></div></div>
  <div class="ml-marketplace-transfer-layout">
    {{> "modules/morelord-marketplace/templates/parts/inventory-table.hbs" rows=transferItems transfer=true scrollKey="transfer-results"}}
    <aside class="ml-marketplace-cart-panel" aria-label="Transfer Shopping Cart">
      <div class="ml-marketplace-cart-heading">
        <div class="ml-marketplace-cart-title"><i class="fa-solid fa-cart-shopping"></i><strong>Shopping Cart</strong></div>
        <span class="ml-marketplace-cart-count">{{transferCartCount}}</span>
      </div>
      <div class="ml-marketplace-cart-items" data-ml-scroll-key="transfer-cart">
        {{#each transferCartItems}}
        <div class="ml-marketplace-cart-line" data-contents-count="{{contentsCount}}">
          <img src="{{img}}" alt="{{name}}" data-link data-uuid="{{uuid}}" title="Open {{name}}">
          <div class="ml-marketplace-cart-line-details">
            <a class="content-link ml-marketplace-cart-item-name" data-link data-uuid="{{uuid}}">{{name}}</a>
            <div class="ml-marketplace-cart-quantity-row">
              <span>Qty</span>
              {{> "modules/morelord-core/templates/components/quantity-controls.hbs" action="adjustTransferQuantity" clearAction="adjustCartQuantity" cartType="transfer" itemId=ownedItemId name=name quantity=cartQty increaseEnabled=canAdd disabled=../isCheckingOut classes="ml-marketplace-quantity-stepper ml-marketplace-cart-stepper" quantityClass="ml-marketplace-cart-qty"}}
            </div>
          </div>
        </div>
        {{else}}<div class="ml-empty-state ml-marketplace-cart-empty"><i class="fa-solid fa-basket-shopping"></i><span>Your transfer cart is empty.</span></div>{{/each}}
      </div>
      <div class="ml-marketplace-cart-footer">
        <div><span>Item Total</span><strong>{{transferCartCount}}</strong></div>
        <button type="button" class="primary" data-action="checkoutTransfer" {{#unless canCheckoutTransfer}}disabled{{/unless}}>{{#if isCheckingOut}}<i class="fa-solid fa-spinner fa-spin"></i> Transferring...{{else}}<i class="fa-solid fa-right-left"></i> Transfer Items{{/if}}</button>
        {{#if transferCartCount}}<button type="button" data-action="clearTransfer"><i class="fa-solid fa-trash"></i> Clear Cart</button>{{/if}}
      </div>
    </aside>
  </div>
</section>
